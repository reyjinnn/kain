{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "checkJs": true,
    "allowJs": true,
    "noImplicitAny": false,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/app.js",
    "src/core/**/*.js",
    "src/config/**/*.js",
    "src/features/**/*.js",
    "src/preview/diagrams.js"
  ]
}
